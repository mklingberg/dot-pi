{
  "icons": {
    "mode": "nerd",
    "cwd": "",
    "git": "",
    "ahead": "↑",
    "behind": "↓",
    "diverged": "⇕",
    "conflicted": "=",
    "untracked": "?",
    "stashed": "$",
    "modified": "!",
    "staged": "+",
    "renamed": "»",
    "deleted": "✘",
    "typechanged": "T"
  },
  "colors": {
    "cwdText": "syntaxOperator",
    "git": "syntaxKeyword",
    "gitStatus": "error",
    "contextNormal": "muted",
    "contextWarning": "warning",
    "contextError": "error",
    "tokens": "muted",
    "cost": "success",
    "separator": "borderMuted"
  },
  "components": {
    "editor": {
      "enabled": true,
      "style": "accent-rail",
      "codexQuota": false,
      "colorSource": "theme",
      "borderColorMode": "adaptive",
      "modelLabel": "id",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "compact",
          "contextFormat": "percent",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showCacheHit": false,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "separator": "dash"
        }
      }
    },
    "footer": {
      "style": "starship",
      "codexQuota": false,
      "colorSource": "theme",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "$cwd( on $git_branch)( $git_status)( via $runtime)$fill$model($sep$thinkingLevel)($sep$context)($sep$cost)",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep($thinkingLevel)$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 2,
          "separator": "none",
          "contextStyle": "gauge",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "repository",
            "depth": 1
          },
          "segments": {
            "cwd": true,
            "sessionName": false,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": true,
            "modelInfo": true,
            "context": true,
            "tokens": false,
            "cost": true,
            "sessionDuration": false,
            "username": false,
            "time": true,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    },
    "userMessages": {
      "enabled": false,
      "style": "framed-copy-friendly",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "theme"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": false,
      "turnSummaryFormat": "Turn took $turn_duration$join_sep(thought for $thought_duration)$join_sep(↑$input_tokens ↓$output_tokens)",
      "spinner": "star-bloom",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "placement": "above",
      "colorSource": "theme",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tokenRate": false,
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": false
      }
    },
    "extensionStatuses": {
      "defaultVisibility": "show"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "rail"
    }
  }
}
