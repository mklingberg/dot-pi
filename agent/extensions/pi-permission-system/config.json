{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/Library/Keychains/*": "deny",
      "~/Library/Application Support/com.apple.TCC/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.git-credentials": "deny",
      "*/.git-credentials": "deny",
      "*-credentials.json": "deny",
      "*serviceAccount*.json": "deny",
      "*service-account*.json": "deny",
      "*/kubeconfig": "deny",
      "*-secret.yaml": "deny",
      "*/secrets.yaml": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.tfstate": "deny",
      "*.tfstate.backup": "deny",
      "*/.terraform/*": "deny",
      "*/.supabase/*": "deny",
      "*/dump.sql": "deny",
      "*/backup.sql": "deny",
      "*.dump": "deny"
    },
    "path_write": {
      "/System/*": "deny",
      "/Library/*": "deny",
      "/Applications/*": "deny",
      "/etc/*": "deny",
      "/usr/*": "deny",
      "/sbin/*": "deny",
      "~/Library/*": "deny",
      "~/.claude/*": "deny",
      "~/.bash_history": "deny",
      "~/.zsh_history": "deny",
      "~/.node_repl_history": "deny",
      "~/.bashrc": "deny",
      "~/.profile": "deny",
      "~/.bash_profile": "deny",
      "*/package-lock.json": "ask",
      "*/yarn.lock": "ask",
      "*/pnpm-lock.yaml": "ask",
      "*/Gemfile.lock": "ask",
      "*/poetry.lock": "ask",
      "*/Pipfile.lock": "ask",
      "*/composer.lock": "ask",
      "*/Cargo.lock": "ask",
      "*/go.sum": "ask",
      "*/flake.lock": "ask",
      "*/uv.lock": "ask",
      "*/npm-shrinkwrap.json": "ask",
      "*.lock": "ask",
      "*.lockb": "ask",
      "*.min.js": "ask",
      "*.min.css": "ask",
      "*.bundle.js": "ask",
      "*.chunk.js": "ask",
      "*/dist/*": "ask",
      "*/build/*": "ask",
      "*/.next/*": "ask",
      "*/.nuxt/*": "ask",
      "*/.output/*": "ask",
      "*/__pycache__/*": "ask",
      "*/.venv/*": "ask",
      "*/venv/*": "ask",
      "*/target/*": "ask",
      "*/LICENSE": "deny",
      "*/LICENSE.*": "deny",
      "*/COPYING": "deny",
      "*/COPYING.*": "deny",
      "*/NOTICE": "deny",
      "*/PATENTS": "deny",
      "*/.git/config": "deny",
      "*/.git/HEAD": "deny",
      "*/.git/packed-refs": "deny",
      "*/.git/refs/*": "deny",
      "*/.git/objects/*": "deny",
      "*/.git/hooks/*": "deny",
      "/private/etc/*": "deny"
    },
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo rm *": {
        "action": "deny",
        "reason": "sudo rm"
      },
      "rmdir --ignore-fail-on-non-empty *": "deny",
      "chmod *777*": {
        "action": "deny",
        "reason": "world-writable"
      },
      "chown -R *root*": "deny",
      "git reset --hard *": {
        "action": "deny",
        "reason": "use --soft or stash"
      },
      "git clean *": "deny",
      "git push *--force*": {
        "action": "deny",
        "reason": "use --force-with-lease"
      },
      "git push -f *": {
        "action": "deny",
        "reason": "use --force-with-lease"
      },
      "git push * -f": {
        "action": "deny",
        "reason": "use --force-with-lease"
      },
      "git push * -f *": {
        "action": "deny",
        "reason": "use --force-with-lease"
      },
      "git push *--force-with-lease*": "allow",
      "git push *--no-force-if-includes*": {
        "action": "deny",
        "reason": "disables the force-with-lease safety check"
      },
      "git push *--mirror*": {
        "action": "deny",
        "reason": "overwrites all remote refs"
      },
      "git push * --delete *": "ask",
      "git push * :*": "ask",
      "git stash clear": "deny",
      "git stash drop *": "ask",
      "git reflog expire *": "deny",
      "git gc *--prune=now*": "deny",
      "git filter-branch *": "deny",
      "git checkout -- .": "ask",
      "git restore .": "ask",
      "git restore -- .": "ask",
      "git submodule deinit *": "ask",
      "git branch -D *": "ask",
      "git branch * -D *": "ask",
      "brew install *": "ask",
      "brew upgrade *": "ask",
      "brew uninstall *": "ask",
      "brew remove *": "ask",
      "brew reinstall *": "ask",
      "brew tap *": "ask",
      "brew untap *": "ask",
      "brew link *": "ask",
      "brew unlink *": "ask",
      "brew update *": "ask",
      "brew pin *": "ask",
      "brew unpin *": "ask",
      "brew autoremove *": "ask",
      "brew cleanup *": "ask",
      "brew bundle *": "ask",
      "mkfs.*": "deny",
      "dd *of=/dev/*": "deny",
      "kill -9 -1": "deny",
      "killall -9 *": "deny",
      "pkill -9 *": "deny",
      "history -c": "deny",
      "az group delete *": "deny",
      "az vm delete *": "deny",
      "az vmss delete *": "deny",
      "az storage account delete *": "deny",
      "az storage container delete *": "deny",
      "az storage blob delete-batch *": "deny",
      "az sql db delete *": "deny",
      "az sql server delete *": "deny",
      "az cosmosdb delete *": "deny",
      "az aks delete *": "deny",
      "az aks nodepool delete *": "deny",
      "az acr delete *": "deny",
      "az functionapp delete *": "deny",
      "az webapp delete *": "deny",
      "az appservice plan delete *": "deny",
      "az keyvault delete *": "deny",
      "az keyvault secret delete *": "deny",
      "az network vnet delete *": "deny",
      "az role assignment delete *": "deny",
      "az role definition delete *": "deny",
      "az ad user delete *": "deny",
      "az ad sp delete *": "deny",
      "az ad app delete *": "deny",
      "az lock delete *": "deny",
      "az resource delete *": "deny",
      "az monitor log-analytics workspace delete *": "deny",
      "az deployment group delete *": "deny",
      "az policy assignment delete *": "deny",
      "kubectl delete *": "ask",
      "kubectl delete namespace *": "deny",
      "kubectl delete node *": "deny",
      "kubectl delete pv *": "deny",
      "kubectl delete pvc *": "deny",
      "kubectl delete all *": "deny",
      "kubectl delete *--all*": "deny",
      "kubectl delete secret *": "deny",
      "kubectl replace *--force*": "deny",
      "kubectl drain *": "ask",
      "kubectl cordon *": "ask",
      "kubectl scale *--replicas=0*": "ask",
      "kubectl rollout undo *": "ask",
      "kubectl config use-context *": "ask",
      "helm uninstall *": "ask",
      "helm delete *": "ask",
      "helm rollback *": "ask",
      "*DELETE FROM*": "ask",
      "*DELETE * FROM*": "deny",
      "*TRUNCATE TABLE*": "deny",
      "*DROP TABLE*": "deny",
      "*DROP DATABASE*": "deny",
      "*DROP SCHEMA*": "deny"
    }
  }
}
